{
  "name": "transformer-monitor",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @transformer-monitor/server",
    "dev:web": "npm run dev -w @transformer-monitor/web",
    "build": "npm run build -w @transformer-monitor/server && npm run build -w @transformer-monitor/web",
    "start": "node apps/server/dist/main.js",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
