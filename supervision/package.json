{
  "name": "transformer-monitor",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @transformer-monitor/server",
    "dev:server:offline": "MQTT_BROKER=none npm run dev -w @transformer-monitor/server",
    "dev:web": "npm run dev -w @transformer-monitor/web",
    "dev": "concurrently --names server,web --prefix-colors blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "build": "npm run build -w @transformer-monitor/server && npm run build -w @transformer-monitor/web",
    "start": "node apps/server/dist/main.js",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.4.0"
  }
}
